generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id                String   @id @default(cuid())
  orderId           String   @unique
  fullName          String
  businessName      String
  mobile            String
  whatsapp          String?
  email             String
  city              String
  crmType           String
  teamSize          String?
  currentMethod     String?
  message           String?
  amount            Float
  paymentStatus     String   @default("PENDING")
  payuTransactionId String?
  paymentReference  String?
  paymentDate       DateTime?
  crmAccountStatus  String   @default("PENDING_SETUP")
  accountCreatedAt  DateTime?
  loginSentAt       DateTime?
  onboardingStatus  String   @default("PENDING_SETUP")
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  adminNotes        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
